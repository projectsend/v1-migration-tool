{
    "name": "projectsend/v1-migration-tool",
    "description": "Imports a ProjectSend v1 (r2098-era) install — database and files — into ProjectSend v2. Installed on demand, removed when the migration is done.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "inertiajs/inertia-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "ProjectSend\\V1Migration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProjectSend\\V1Migration\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProjectSend\\V1Migration\\V1MigrationServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
